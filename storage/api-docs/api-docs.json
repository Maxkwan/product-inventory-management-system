    "components": {
        "schemas": {
            "ProductInput": {
                "required": [
                    "category_id",
                    "name",
                    "sku",
                    "price"
                ],
                "properties": {
                    "category_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Wireless Mouse"
                    },
                    "sku": {
                        "type": "string",
                        "example": "WM-001"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "price": {
                        "type": "number",
                        "format": "float",
                        "example": 49.9,
                        "minimum": 0
                    },
                    "quantity": {
                        "type": "integer",
                        "example": 25,
                        "minimum": 0
                    },
                    "reorder_level": {
                        "type": "integer",
                        "example": 5,
                        "minimum": 0
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    },
                    "supplier_ids": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            1,
                            2
                        ]
                    }
                },
                "type": "object"
            },
            "CategoryInput": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Electronics"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "SupplierInput": {
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "Acme Supplies"
                    },
                    "contact_name": {
                        "type": "string",
                        "example": "Jane Doe",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "nullable": true
                    },
                    "phone": {
                        "type": "string",
                        "nullable": true
                    },
                    "address": {
                        "type": "string",
                        "nullable": true
                    },
                    "is_active": {
                        "type": "boolean",
                        "example": true
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "bearerFormat": "Sanctum token",
                "scheme": "bearer"
            }
        }
    },
